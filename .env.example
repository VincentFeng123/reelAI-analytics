# Server-only Railway PostgreSQL URL. Prefer a dedicated read-only database user.
ANALYTICS_DATABASE_URL=postgresql://analytics_reader:replace-me@host:5432/railway?sslmode=require

# Standalone dashboard login. This deliberately invalid placeholder must be replaced
# with a unique password containing at least 16 characters.
ANALYTICS_PASSWORD=change-me

# This deliberately invalid placeholder must be replaced with at least 32 random
# characters. Example: openssl rand -base64 48
ANALYTICS_SESSION_SECRET=change-me

# Required in production: number of trusted reverse-proxy hops represented at the
# right of X-Forwarded-For. Keep 0 for local development only; verify the platform
# contract before setting a production value.
ANALYTICS_TRUSTED_PROXY_HOPS=0

# Canonical public origin used for login/logout origin checks. Production requires
# the real HTTPS analytics-site origin with no path.
ANALYTICS_PUBLIC_ORIGIN=http://localhost:3000

# Matches billing_subscriptions.provider_environment.
BILLING_ENTITLEMENT_ENVIRONMENT=Production

# Optional external product link shown in the owner console.
NEXT_PUBLIC_PRODUCT_URL=https://studyreels.app/app
